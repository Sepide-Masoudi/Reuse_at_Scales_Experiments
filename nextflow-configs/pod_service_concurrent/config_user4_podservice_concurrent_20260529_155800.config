process {
    executor = 'k8s'
    memory   = '4.GB'
    cpus     = 2
}
executor {
    queueSize = 4
}
k8s {
    namespace        = 'nextflow'
    serviceAccount   = 'nextflow-sa'
    storageClaimName = 'nextflow-pvc'
    storageMountPath = '/workspace'
    computeResourceType = 'Job'
    pod = [
        [nodeSelector: 'role=sut'],
        [label: 'pipeline', value: 'rnaseq'],
        [label: 'user', value: 'user4'],
        [label: 'run_id', value: 'user4_podservice_concurrent_20260529_155800'],
        [label: 'reuse', value: 'pod-service-concurrent'],
        [imagePullPolicy: 'IfNotPresent']
    ]
}
workDir = '/workspace/runs/user4_podservice_concurrent_20260529_155800/work'
