process {
    executor = 'k8s'
    memory   = '4.GB'
    cpus     = 2
}
executor {
    queueSize = 4
}
k8s {
    namespace        = 'nextflow'
    serviceAccount   = 'nextflow-sa'
    storageClaimName = 'nextflow-pvc'
    storageMountPath = '/workspace'
    computeResourceType = 'Job'
    pod = [
        [nodeSelector: 'role=sut'],
        [label: 'pipeline', value: 'rnaseq'],
        [label: 'user', value: 'user2'],
        [label: 'run_id', value: 'user2_reuse50pct_20260526_133607'],
        [label: 'reuse', value: '50pct'],
        [imagePullPolicy: 'IfNotPresent']
    ]
}
workDir = '/workspace/runs/user2_reuse50pct_20260526_133607/work'
