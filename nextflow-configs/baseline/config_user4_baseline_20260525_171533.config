process {
    executor = 'k8s'
    memory   = '2.GB'
    cpus     = 2
    maxForks = 2
}
executor {
    queueSize = 2
}
k8s {
    namespace        = 'nextflow'
    serviceAccount   = 'nextflow-sa'
    storageClaimName = 'nextflow-pvc'
    storageMountPath = '/workspace'
    storageWorkDir   = '/workspace/runs/user4_baseline_20260525_171533/work'
    computeResourceType = 'Job'
    pod = [
        [nodeSelector: 'role=sut'],
        [label: 'pipeline', value: 'rnaseq'],
        [label: 'user', value: 'user4'],
        [label: 'run_id', value: 'user4_baseline_20260525_171533'],
        [label: 'reuse', value: 'baseline'],
        [imagePullPolicy: 'IfNotPresent']
    ]
}
workDir = '/workspace/runs/user4_baseline_20260525_171533/work'
