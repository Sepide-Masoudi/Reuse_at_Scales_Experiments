  #!/usr/bin/env python3
  import urllib.request, urllib.error, json, os, sys, time
  
  cwd = os.getcwd()
  bams = [os.path.join(cwd, b) for b in "SAMPLE_10.markdup.sorted.bam".split()]
  anno = os.path.join(cwd, "genome_gfp.gtf") if "genome_gfp.gtf" else ""
  
  payload = {
      "bams": bams, "annotation": anno, "outdir": "/workspace/service_outputs/featurecounts/SAMPLE_10",
      "prefix": "SAMPLE_10", "paired_end": False,
      "strandedness": 2, "cpus": 1, "args": "-B -C -g gene_biotype -t exon"
  }
  
  url = "http://10.108.214.73:8080/run"
  
  for attempt in range(1, 6):
      try:
          print(f"Attempt {attempt}/5...", file=sys.stderr)
          req = urllib.request.Request(url, json.dumps(payload).encode(), {"Content-Type": "application/json"}, method="POST")
          response_text = urllib.request.urlopen(req, timeout=600).read().decode()
          print("Success!", file=sys.stderr)
          break
      except urllib.error.HTTPError as e:
          print(f"HTTP {e.code}. Waiting {10*attempt}s...", file=sys.stderr)
          time.sleep(10 * attempt)
      except Exception as e:
          print(f"Error: {e}. Waiting {10*attempt}s...", file=sys.stderr)
          time.sleep(10 * attempt)
  else:
      print("All retries failed", file=sys.stderr); sys.exit(1)
  
  result = json.loads(response_text)
  if result.get("status") != "success":
      print(f"Service failed: {response_text}", file=sys.stderr); sys.exit(1)
  
  os.symlink(result["counts"], "SAMPLE_10.featureCounts.tsv")
  os.symlink(result["summary"], "SAMPLE_10.featureCounts.tsv.summary")

